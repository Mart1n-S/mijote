{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git clean *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh project *)",
      "Bash(gh api *)",
      "Bash(gh workflow *)",
      "Bash(docker compose down *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(~/.ssh/**)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh release delete *)",
      "Bash(npx playwright uninstall *)",
      "Bash(pnpm exec playwright uninstall *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push *--force*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh auth *)",
      "PowerShell(gh repo delete *)"
    ]
  }
}
