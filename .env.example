# Copier ce fichier en .env et renseigner les valeurs. Le .env n'est jamais commité.

# PostgreSQL de développement, lu par docker-compose.yml.
#
# Le port 5433 et non 5432 : un PostgreSQL 16 natif tourne déjà sur le poste
# (service Windows postgresql-x64-16) et occupe 5432. Sans ce décalage, c'est
# lui qui répond, et une migration risque d'écrire dans la mauvaise base, sur
# une version majeure différente, sans rien signaler.
#
# Le mot de passe doit être identique dans POSTGRES_PASSWORD et dans
# DATABASE_URL : le premier crée le compte au tout premier démarrage du
# conteneur, le second sert à s'y connecter. Dans l'URL, les caractères
# spéciaux doivent être encodés en pourcentage : @ devient %40, : devient
# %3A, / devient %2F, # devient %23.
#
# Changer POSTGRES_PASSWORD après coup ne change rien : le compte n'est créé
# qu'à l'initialisation du volume. Il faut recréer celui-ci, ce qui détruit la
# base de développement :
#
#   docker compose down -v && docker compose up -d && pnpm db:migrate
POSTGRES_USER=mijote
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mijote
POSTGRES_PORT=5433

# Connexion utilisée par l'API et par drizzle-kit
DATABASE_URL=postgres://mijote:changeme@localhost:5433/mijote

# API
NODE_ENV=development
API_PORT=3000

# Niveau de journalisation de l'API, lu par apps/api/src/logging/logger-options.ts.
#
# Valeurs acceptées : silent, fatal, error, warn, info, debug, trace. Une autre
# valeur fait échouer le démarrage, plutôt que de passer pour un réglage
# appliqué.
#
# Vide, le niveau vaut debug en développement et info ailleurs. En production,
# debug et trace sont ramenés à info : ce détail n'a rien à faire dans des
# journaux conservés. silent ne sert qu'aux tests.
LOG_LEVEL=

# Mailpit, serveur SMTP de développement (docker-compose.yml). Il capture tous
# les messages et n'en envoie aucun : son interface web est sur
# http://localhost:8025, et les messages disparaissent à l'arrêt du conteneur.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Envoi d'e-mails par l'API. En développement, ces valeurs visent Mailpit.
#
# SMTP_USER et SMTP_PASSWORD restent vides en développement : Mailpit
# n'authentifie personne, et il n'écoute que sur la boucle locale. En
# production, le fournisseur les imposera, et ils ne vivent que dans le .env.
#
# SMTP_SECURE vaut true seulement si le serveur attend du TLS dès la connexion,
# ce qui est le cas du port 465. Sur 587, la connexion démarre en clair puis
# passe en TLS par STARTTLS : SMTP_SECURE reste alors false.
#
# Dès que SMTP_USER est renseignée, le chiffrement est exigé avant toute
# authentification : un serveur qui ne propose pas STARTTLS fait échouer l'envoi
# plutôt que d'envoyer le mot de passe en clair.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Expéditeur des e-mails. Jamais une adresse personnelle : c'est l'adresse de
# l'application, et elle part dans chaque message envoyé.
MAIL_FROM=Mijote <no-reply@mijote.local>

# Cible du mandataire /api, lue par apps/web/vite.config.ts en développement et
# en prévisualisation.
#
# Le navigateur, lui, ne connaît aucune adresse d'API : il appelle /api sur sa
# propre origine, et c'est ce mandataire (ou le serveur frontal en production)
# qui l'envoie à l'API. Il n'y a donc aucune requête entre origines.
VITE_API_URL=http://localhost:3000

# Clé d'API Context7, facultative : elle ne sert qu'à relever les limites de
# débit du service, le skill fonctionne sans. Elle n'est lue que par
# .claude/skills/context7/scripts/context7.sh, jamais par l'application.
#
# Laissée vide ici exprès. Elle se demande sur https://context7.com/dashboard,
# et sa valeur ne va que dans le .env, qui n'est jamais commité.
CONTEXT7_API_KEY=
